APP_NAME=ByaheGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: Neon Postgres, for local development and production alike.
# Paste the DIRECT connection string from Neon (Dashboard > Connect, turn "Connection pooling" OFF,
# so the host has no "-pooler" in it). The pooled host breaks migrations.
# Never commit the real value. Automated tests use in-memory SQLite (see phpunit.xml).
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Comma-separated list of sites allowed to call the API (your Vercel URL). Use * to allow any.
CORS_ALLOWED_ORIGINS=*

# The website the API sends people back to after Google / Facebook sign-in and in password reset emails.
FRONTEND_URL=http://localhost:5173

# Google sign-in (leave empty to hide the button). Redirect URI to register: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook sign-in (leave empty to hide the button). Redirect URI to register: {APP_URL}/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Payments (Xendit). Use the TEST secret key (starts with xnd_development_) until you go live.
# Dashboard -> Settings -> API keys. The callback token is under Settings -> Webhooks.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Local only: if PHP says "SSL certificate problem: unable to get local issuer certificate" (common on Windows), point this at a
# CA bundle file (Git for Windows ships one at C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt). Not needed on Render.
XENDIT_CA_BUNDLE=

# ID verification: critical failures are always auto-rejected. Set to true to also auto-approve submissions where every
# check passes with a safe margin (thresholds and margins live in config/verification.php). Off = admins review everything else.
VERIFICATION_AUTO_APPROVE=false

# Shown to blocked people as the place to appeal.
SUPPORT_EMAIL=support@byahego.ph

# true: log time and query count of every API request to storage/logs/perf.log; sql: also list every query
PERF_LOG=false

# Local development against a far-away Neon region: keep the database connection open between requests. Opening a fresh
# TLS connection costs about a second each time; with this on it is paid once. Leave off on a hosted server (Apache runs
# many workers and each would hold a Neon connection).
DB_PERSISTENT=false
# Optional label shown in the database's session list.
DB_APPLICATION_NAME=

# Demo data. Locally the seeder makes up a password and prints it (or set DEMO_PASSWORD yourself).
# On a live site demo data is off unless SEED_DEMO_DATA=true, and then DEMO_PASSWORD (12+ characters) is required. Never commit real values.
SEED_DEMO_DATA=false
DEMO_PASSWORD=
# On a live site the demo accounts come with cars but NO sample trips, payments or reviews unless this is true.
SEED_DEMO_TRIPS=false
# Optional real administrator for a live site (created once if that email has no account). ADMIN_PASSWORD needs 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Minutes a sign-in lasts. Empty = never expires (local only); the Render blueprint sets 30 days.
SANCTUM_TOKEN_EXPIRATION=
