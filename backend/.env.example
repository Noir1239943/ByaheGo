APP_NAME=ByaheGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local development: SQLite works out of the box (touch database/database.sqlite).
DB_CONNECTION=sqlite
# Production (Neon): set DB_CONNECTION=pgsql and paste your Neon connection string here, e.g.
# DB_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_URL=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Comma-separated list of sites allowed to call the API (your Vercel URL). Use * to allow any.
CORS_ALLOWED_ORIGINS=*

# Optional: Google OAuth client ID for "Continue with Google" (same value as the frontend's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# ID verification: critical failures are always auto-rejected. Set to true to also auto-approve submissions where every
# check passes with a safe margin (thresholds and margins live in config/verification.php). Off = admins review everything else.
VERIFICATION_AUTO_APPROVE=false
